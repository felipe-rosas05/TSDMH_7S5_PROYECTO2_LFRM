<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/panelSolicitud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="80dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/fondo_descarga"
            android:importantForAccessibility="no"
            android:padding="20dp"
            android:src="@android:drawable/stat_sys_download"
            android:tint="#23699D" />

        <Button
            android:id="@+id/btnSolicitar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#176AA6"
            android:text="@string/solicitar"
            android:textColor="#FFFFFF" />

        <ProgressBar
            android:id="@+id/barraProgreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="20dp"
            android:max="100"
            android:progressTint="#176AA6"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/txtCarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#263238"
            android:visibility="invisible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelSeleccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/spinnerCategorias"
            android:text="@string/elige_categoria"
            android:textColor="#16232E"
            android:textSize="17sp" />

        <Spinner
            android:id="@id/spinnerCategorias"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:saveEnabled="false" />

    </LinearLayout>

</LinearLayout>
